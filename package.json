{
  "name": "altx-open-insurance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --manifest && node scripts/routes.mjs && node scripts/source.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "deploy": "wrangler pages deploy dist",
    "format:check": "prettier --check src tests scripts package.json index.html"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "ical.js": "^2.2.1",
    "prettier": "^3.9.9",
    "vite": "^6.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
